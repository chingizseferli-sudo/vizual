# Vizual workers - environment variables. Copy to .env for local runs; never commit real values.
# Values shown are the code defaults unless noted.

# ---- Process selection (start.sh) -------------------------------------------
# rss | social | discovery | discovery_deep | sync_sources | auto_configure | readability
WORKER=rss
TZ=Asia/Baku

# ---- Shared ------------------------------------------------------------------
SUPABASE_URL=
# Service-role key bypasses RLS: set it only on worker services, never on the web app.
SUPABASE_SERVICE_ROLE_KEY=
# Domains (suffixes, comma separated) never crawled (rss, discovery, sync, readability)
EXCLUDED_DOMAIN_SUFFIXES=gov.az

# ---- rss: site_monitor.py ----------------------------------------------------
BOT_TOKEN=
CHAT_ID=
# 0 = loop forever (start.sh default for WORKER=rss); 1 = single pass then exit
RUN_ONCE=0
CHECK_INTERVAL_SECONDS=60
NOTIFY_START=0
MAX_WORKERS=10
REQUEST_TIMEOUT=10
MAX_SEND_PER_RUN=10
MAX_LINKS_PER_SITE=10
NEWS_TIME_LIMIT_HOURS=1
GOOGLE_NEWS_FALLBACK_HOURS=1
MONITOR_DATA_RETENTION_DAYS=30
LOG_RETENTION_DAYS=14
SOURCE_HEALTH_ENABLED=false
SOURCE_MAX_CONSECUTIVE_FAILS=5
# Empty reads (page answered, nothing extracted) in a row before the source counts as failing.
EMPTY_READ_FAIL_THRESHOLD=3
SOURCE_DEFAULT_INTERVAL_MINUTES=60
SOURCE_SITEMAP_SCAN_LIMIT=50
DOMAIN_REQUEST_JITTER_SECONDS=0.35
CRAWLER_USER_AGENT=VizualAzMonitor/1.0 (+https://vizual.az; contact: support@vizual.az)
SCHEDULER_DRY_RUN=false
DISABLE_TELEGRAM_SEND=false
# true re-enables legacy `/start <user uuid>` linking (insecure: anyone knowing the UUID can link). Tokens from the profile page are the default.
TELEGRAM_ALLOW_LEGACY_UUID_LINK=false
VERIFY_RELEASE_REPAIR_ONLY=false
# Competitors page (Rəqiblər): Claude labels headline tone and writes a daily
# brief per customer (model claude-haiku-5-5). Empty = counts only, no AI text.
ANTHROPIC_API_KEY=

# ---- social: social/collector.py ---------------------------------------------
# Needs BOT_TOKEN too (alerts go through the news bot). Platforms are switched on
# in /admin/social; intervals come from plans and per-customer overrides.
APIFY_TOKEN=
SOCIALFETCH_API_KEY=
# YouTube Data API v3 key (Google Cloud, restricted to that API). Free daily quota.
YOUTUBE_API_KEY=
SOCIAL_TICK_SECONDS=300
SOCIAL_MAX_POSTS_PER_QUERY=10
SOCIAL_MAX_AGE_HOURS=48
APIFY_RUN_TIMEOUT_SECONDS=600
# Used for the monthly budget only when the provider reports no cost.
APIFY_FB_USD_PER_QUERY_ESTIMATE=0.05
SOCIALFETCH_USD_PER_CREDIT_ESTIMATE=0.01

# ---- discovery / discovery_deep: discovery_bot.py ----------------------------
DISCOVERY_BLOCK_GOV=true
DISCOVERY_WRITE_JSON=false
DISCOVERY_SYNC_SUPABASE=true
DISCOVERY_REQUIRE_ACTIVITY=true
DISCOVERY_MIN_NEWS_PER_PERIOD=15
DISCOVERY_ACTIVITY_LOOKBACK_HOURS=24
DISCOVERY_MAX_QUERIES=0
DISCOVERY_MAX_ENTRIES_PER_QUERY=0
DISCOVERY_BUILD_PATTERNS=true
DISCOVERY_INCLUDE_EDU_SPECIALIZED=false
DISCOVERY_SUBDOMAIN_ALLOWLIST=

# ---- sync_sources: sync_sources_to_supabase.py -------------------------------
SYNC_SUBDOMAIN_ALLOWLIST=

# ---- auto_configure / readability --------------------------------------------
AUTO_CONFIG_SCOPE=problems
AUTO_CONFIG_LIMIT=0
AUTO_CONFIG_METHODS=
# falls back to MAX_WORKERS, then 8
AUTO_CONFIG_WORKERS=8
# readability uses MAX_WORKERS (default 10) and REQUEST_TIMEOUT (default 12)
LIMIT_SOURCES=0
